# =============================================================================
# SolarJi Frontend — copy to frontend/.env (dev) or frontend/.env.production (build)
# Never commit .env / .env.production (gitignored)
# =============================================================================

# Backend API base URL (required — no fallback in code)
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production build example:
# VITE_API_URL=https://your-api.onrender.com/api

# EmailJS Service Credentials (for Contact / Helpdesk form)
# Sign up free at https://emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
